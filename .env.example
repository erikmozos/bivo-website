# Firebase (proyecto bivo-6b26a)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=bivo-6b26a
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# RevenueCat Web Billing (Stripe) — pedir al backend
# Live: strp_... | Sandbox: strp_sb_... (debe coincidir con productos Stripe en RC)
# NO usar pk_live_, appl_, goog_ ni sk_
VITE_REVENUECAT_API_KEY=

# Opcional: emulador de Cloud Functions en desarrollo
# VITE_FIREBASE_FUNCTIONS_EMULATOR=true

# SendPulse (serverless /api)
SENDPULSE_CLIENT_ID=
SENDPULSE_CLIENT_SECRET=
SENDPULSE_FROM_EMAIL=
SENDPULSE_ADDRESSBOOK_ID=

# Plantillas transaccionales del flujo app (registro + onboarding).
# Por defecto: Bienvenida ES=94006, Welcome EN=94686.
# SENDPULSE_WELCOME_TEMPLATE_ID_ES=94006
# SENDPULSE_WELCOME_TEMPLATE_ID_EN=94686
# SENDPULSE_ONBOARDING_TEMPLATE_ID_ES=94006
